{
	"name": "thunderous-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Thunderous monorepo",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"postinstall": "test -d .browsers || PLAYWRIGHT_BROWSERS_PATH=.browsers/ playwright install",
		"quality": "turbo run typecheck lint format build test",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"format:fix": "turbo run format:fix",
		"test": "turbo run test",
		"test:server": "turbo run test:server",
		"test:client": "turbo run test:client",
		"dev": "turbo run dev --parallel",
		"dev:www": "turbo run dev --filter=thunderous-docs",
		"w:core": "cd packages/thunderous && pnpm",
		"w:server": "cd packages/thunderous-server && pnpm",
		"w:csr": "cd packages/thunderous-csr && pnpm",
		"w:create": "cd packages/create-thunderous && pnpm",
		"publish:all": "node scripts/publish-all.js",
		"publish:all:dry": "node scripts/publish-all.js --dry-run",
		"clean": "turbo run clean 2>/dev/null || rm -rf packages/*/dist packages/*/node_modules/.cache www/dist"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.54.1",
		"@types/dom-navigation": "^1.0.7",
		"@types/eslint": "^8.56.10",
		"@types/node": "^24.12.0",
		"@typescript-eslint/eslint-plugin": "^8.17.0",
		"@typescript-eslint/parser": "^8.17.0",
		"c8": "^10.1.2",
		"eslint": "^10.1.0",
		"eslint-plugin-node": "^11.1.0",
		"globals": "^17.4.0",
		"prettier": "^3.3.3",
		"tsup": "^8.5.1",
		"tsx": "^4.19.2",
		"turbo": "^2.9.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	}
}

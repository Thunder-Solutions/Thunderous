{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env", "tsconfig.json", "tsconfig.eslint.json"],
	"globalEnv": ["NODE_ENV", "PLAYWRIGHT_BROWSERS_PATH"],
	"ui": "tui",
	"tasks": {
		"build": {
			"outputs": ["dist/**"]
		},
		"typecheck": {},
		"lint": {},
		"lint:fix": {
			"cache": false
		},
		"format": {},
		"format:fix": {
			"cache": false
		},
		"test": {},
		"test:server": {},
		"test:client": {
			"env": ["PLAYWRIGHT_BROWSERS_PATH"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"prepublishOnly": {
			"cache": false
		},
		"clean": {
			"cache": false
		}
	}
}

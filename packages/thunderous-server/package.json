{
	"name": "thunderous-server",
	"version": "0.0.6",
	"description": "A simple server to enhance Thunderous components with SSR.",
	"license": "MIT",
	"author": "Jonathan DeWitt <jon.dewitt@thunder.solutions>",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup --no-clean",
		"demo": "cd demo && npm run",
		"demo:install": "cd demo && npm install",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check . --ignore-path ../../.gitignore",
		"format:fix": "prettier --write . --ignore-path ../../.gitignore",
		"typecheck": "tsc --noEmit",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"bin": {
		"thunderous": "./bin/thunderous"
	},
	"files": [
		"/dist",
		"/bin",
		"/src",
		"/types",
		"/package.json",
		"/README.md"
	],
	"devDependencies": {
		"@eslint/css": "^0.13.0",
		"@eslint/js": "^9.38.0",
		"@eslint/json": "^0.13.2",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^24.9.1",
		"@types/resolve": "^1.20.6",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"eslint": "^9.38.0",
		"prettier": "^3.6.2",
		"serve": "^14.2.5",
		"thunderous": "workspace:*",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"undici-types": "^7.16.0"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"emoji-space-shim": "^0.1.7",
		"es-module-lexer": "^1.7.0",
		"node-emoji": "^2.2.0",
		"resolve": "^1.22.11",
		"resolve.exports": "^2.0.3",
		"string-width": "^8.2.0",
		"vite": "^6.3.5"
	},
	"peerDependencies": {
		"thunderous": ">=2.4.3"
	}
}
